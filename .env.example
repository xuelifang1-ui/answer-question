# 运行 python scripts/init_env.py 生成随机值；不要把真实 .env 提交到 Git。
DJANGO_SECRET_KEY=replace-with-random-value
FERNET_KEY=replace-with-generated-fernet-key
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DB_ENGINE=postgresql
DB_NAME=instance_manager
DB_USER=manager
DB_PASSWORD=replace-with-random-value
DB_HOST=127.0.0.1
DB_PORT=5432
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
TARGET_ALLOWED_CIDRS=127.0.0.1/32,::1/128,172.30.66.0/24
TARGET_SSLMODE=prefer
DEMO_SUBNET=172.30.66.0/24
DEMO_TARGET_IP=172.30.66.10
DEMO_ADMIN_PASSWORD=replace-with-random-value
DEMO_APP_PASSWORD=replace-with-random-value
